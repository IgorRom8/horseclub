# PostgreSQL для Prisma (страницы, галерея, настройки главной). Для формы «Заявка» база не обязательна.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/konclub?schema=public"

# Админка: по умолчанию /admin открыт без пароля (и на Vercel). Перед настоящим продом:
# ADMIN_OPEN_ACCESS=false
# и задайте ADMIN_SESSION_SECRET, ADMIN_USERNAME, ADMIN_PASSWORD

# По желанию: скопировать текст заявки в Discord / Make.com (на сайте пользователю всегда показывается «отправлено»).
# CONTACT_WEBHOOK_URL=https://discord.com/api/webhooks/...

NEXT_PUBLIC_CLUB_CITY=Подмосковье
NEXT_PUBLIC_WA_LINK=https://wa.me/79000000000
NEXT_PUBLIC_TG_LINK=https://t.me/your_stable
# Номер для блока «Остались вопросы?» (отображение и ссылка tel:)
NEXT_PUBLIC_MANAGER_PHONE=+7 (900) 000-00-00
# Опционально: публичный URL сайта
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Вставьте URL из конструктора карт Яндекса (embed)
NEXT_PUBLIC_YANDEX_MAP_EMBED=https://yandex.ru/map-widget/v1/
