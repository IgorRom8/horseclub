generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Page {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  content   Json
  updatedAt DateTime @updatedAt
}

model GalleryImage {
  id           String  @id @default(cuid())
  imageUrl     String
  thumbnailUrl String
  title        String
  page         String
  order        Int     @default(0)
  description  String?
  detail       String? @db.Text
}

/** Ключ–значение: site_images и home_texts (JSON) для главной */
model SiteSetting {
  key   String @id
  value String @db.Text
}

model ContactRequest {
  id            String    @id @default(cuid())
  name          String
  phone         String
  message       String?
  serviceSlug   String?
  preferredDate DateTime?
  createdAt     DateTime  @default(now())
  status        String    @default("new")
}
