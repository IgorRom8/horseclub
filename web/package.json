{

  "name": "web",

  "version": "0.1.0",

  "private": true,

  "scripts": {

    "clean": "node scripts/clean-next.cjs",

    "dev": "next dev",

    "build": "prisma generate && next build",

    "postinstall": "prisma generate",

    "start": "next start",

    "lint": "next lint",

    "download-images": "node scripts/download-site-images.mjs",

    "images:sync": "node scripts/sync-from-root-images.mjs",

    "images:placeholders": "node scripts/write-svg-placeholders.mjs",

    "db:generate": "dotenv -e .env.local -- prisma generate",

    "db:push": "dotenv -e .env.local -- prisma db push",

    "db:seed": "dotenv -e .env.local -- tsx prisma/seed.ts"

  },

  "prisma": {

    "seed": "tsx prisma/seed.ts"

  },

  "dependencies": {

    "@prisma/client": "^6.7.0",

    "next": "^15.1.0",

    "react": "^19.0.0",

    "react-dom": "^19.0.0",

    "yet-another-react-lightbox": "^3.21.7"

  },

  "devDependencies": {

    "@types/node": "^22.10.1",

    "@types/react": "^19.0.1",

    "@types/react-dom": "^19.0.2",

    "autoprefixer": "^10.4.20",

    "eslint": "^9.16.0",

    "eslint-config-next": "^15.1.0",

    "postcss": "^8.4.49",

    "prisma": "^6.7.0",

    "tailwindcss": "^3.4.16",

    "dotenv-cli": "^9.0.0",

    "tsx": "^4.19.2",

    "typescript": "^5.7.2"

  }

}

